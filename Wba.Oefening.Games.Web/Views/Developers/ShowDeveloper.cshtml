@model DevelopersDetailViewModel

<h2>Developer details</h2>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">@Model.Name</h3>
    </div>
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>Id</dt>
            <dd>@Model.Id</dd>
        </dl>
        <dl class="dl-horizontal">
            <dt>Name</dt>
            <dd>@Model.Name</dd>
        </dl>
        @* call the gamesListpartial *@
        <partial name="_GameListPartial" model="@Model.Games" />
    </div>
</div>

<p>
    <a asp-controller="Developers" asp-action="Index" class="btn btn-primary">&laquo; Show all developers</a>
</p>

